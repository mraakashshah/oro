+
+// ---------------------------------------------------------------------------
+// Project column and SetProject scoping tests (oro-1rep.5)
+// ---------------------------------------------------------------------------
+
+//nolint:funlen // comprehensive coverage across 6 subtests
+func TestSetProjectScopesSearchAndInsert(t *testing.T) {
+	ctx := context.Background()
+
+	t.Run("Insert stamps project field", func(t *testing.T) {
+		db := setupTestDB(t)
+		store := NewStore(db)
+		store.SetProject("myproject")
+
+		id, err := store.Insert(ctx, InsertParams{
+			Content:    "unique_stamp_proj_xyz project stamping test",
+			Type:       "lesson",
+			Source:     "self_report",
+			Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert: %v", err)
+		}
+
+		var project string
+		err = db.QueryRowContext(ctx, `SELECT project FROM memories WHERE id = ?`, id).Scan(&project)
+		if err != nil {
+			t.Fatalf("query project: %v", err)
+		}
+		if project != "myproject" {
+			t.Errorf("expected project='myproject', got %q", project)
+		}
+	})
+
+	t.Run("Search returns only project A memories", func(t *testing.T) {
+		db := setupTestDB(t)
+		storeA := NewStore(db)
+		storeA.SetProject("projA")
+		storeB := NewStore(db)
+		storeB.SetProject("projB")
+
+		_, err := storeA.Insert(ctx, InsertParams{
+			Content: "unique_scope_abc project alpha memory lesson", Type: "lesson",
+			Source: "self_report", Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert A: %v", err)
+		}
+		_, err = storeB.Insert(ctx, InsertParams{
+			Content: "unique_scope_abc project beta memory lesson", Type: "lesson",
+			Source: "self_report", Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert B: %v", err)
+		}
+
+		results, err := storeA.Search(ctx, "unique_scope_abc", SearchOpts{Limit: 10})
+		if err != nil {
+			t.Fatalf("search A: %v", err)
+		}
+		if len(results) != 1 {
+			t.Errorf("expected 1 result for projA, got %d", len(results))
+		}
+		if len(results) > 0 && !strings.Contains(results[0].Content, "alpha") {
+			t.Errorf("expected projA memory (alpha), got: %s", results[0].Content)
+		}
+	})
+
+	t.Run("SetProject empty string returns all memories", func(t *testing.T) {
+		db := setupTestDB(t)
+		storeA := NewStore(db)
+		storeA.SetProject("projA")
+		storeB := NewStore(db)
+		storeB.SetProject("projB")
+		storeAll := NewStore(db)
+		// storeAll has no project set — default empty string
+
+		_, err := storeA.Insert(ctx, InsertParams{
+			Content: "unique_allproj_xyz alpha memory", Type: "lesson",
+			Source: "self_report", Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert A: %v", err)
+		}
+		_, err = storeB.Insert(ctx, InsertParams{
+			Content: "unique_allproj_xyz beta memory", Type: "lesson",
+			Source: "self_report", Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert B: %v", err)
+		}
+
+		results, err := storeAll.Search(ctx, "unique_allproj_xyz", SearchOpts{Limit: 10})
+		if err != nil {
+			t.Fatalf("search all: %v", err)
+		}
+		if len(results) != 2 {
+			t.Errorf("expected 2 results with empty project filter, got %d", len(results))
+		}
+	})
+
+	t.Run("ForPrompt scoped to project", func(t *testing.T) {
+		db := setupTestDB(t)
+		storeA := NewStore(db)
+		storeA.SetProject("projA")
+		storeB := NewStore(db)
+		storeB.SetProject("projB")
+
+		_, err := storeA.Insert(ctx, InsertParams{
+			Content: "unique_prompt_proj_xyz alpha lesson content", Type: "lesson",
+			Source: "self_report", Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert A: %v", err)
+		}
+		_, err = storeB.Insert(ctx, InsertParams{
+			Content: "unique_prompt_proj_xyz beta lesson content", Type: "lesson",
+			Source: "self_report", Confidence: 0.9,
+		})
+		if err != nil {
+			t.Fatalf("insert B: %v", err)
+		}
+
+		output, err := ForPrompt(ctx, storeA, nil, "unique_prompt_proj_xyz", 500)
+		if err != nil {
+			t.Fatalf("ForPrompt: %v", err)
+		}
+		if !strings.Contains(output, "alpha") {
+			t.Errorf("expected projA memory (alpha) in ForPrompt output, got: %s", output)
+		}
+		if strings.Contains(output, "beta") {
+			t.Errorf("expected no projB memory (beta) in ForPrompt output, got: %s", output)
+		}
+	})
+
+	t.Run("Backfill migration sets existing rows to project=oro", func(t *testing.T) {
+		db := setupTestDB(t)
+
+		// Insert without explicit project — defaults to ''
+		_, err := db.ExecContext(ctx,
+			`INSERT INTO memories (content, type, tags, source, confidence) VALUES (?, ?, ?, ?, ?)`,
+			"old memory without project backfill test", "lesson", "[]", "self_report", 0.8,
+		)
+		if err != nil {
+			t.Fatalf("insert old row: %v", err)
+		}
+
+		// Verify it's empty before backfill
+		var project string
+		err = db.QueryRowContext(ctx, `SELECT project FROM memories`).Scan(&project)
+		if err != nil {
+			t.Fatalf("query before backfill: %v", err)
+		}
+		if project != "" {
+			t.Errorf("expected project='' before backfill, got %q", project)
+		}
+
+		// Run backfill migration
+		_, err = db.ExecContext(ctx, protocol.MigrateBackfillProject)
+		if err != nil {
+			t.Fatalf("backfill migration: %v", err)
+		}
+
+		err = db.QueryRowContext(ctx, `SELECT project FROM memories`).Scan(&project)
+		if err != nil {
+			t.Fatalf("query after backfill: %v", err)
+		}
+		if project != "oro" {
+			t.Errorf("expected project='oro' after backfill, got %q", project)
+		}
+	})
+
+	t.Run("Migration is idempotent", func(t *testing.T) {
+		db := setupTestDB(t)
+
+		// SchemaDDL already creates the project column; running MigrateProjectColumn
+		// again should not break the DB (errors are ignored via try/ignore pattern).
+		_, _ = db.ExecContext(ctx, protocol.MigrateProjectColumn)
+
+		// Insert and query to verify DB is functional after duplicate migration attempt
+		_, err := db.ExecContext(ctx,
+			`INSERT INTO memories (content, type, tags, source, confidence) VALUES (?, ?, ?, ?, ?)`,
+			"idempotent migration check", "lesson", "[]", "self_report", 0.8,
+		)
+		if err != nil {
+			t.Errorf("DB not functional after duplicate migration attempt: %v", err)
+		}
+
+		// Run backfill twice — must be idempotent
+		_, err = db.ExecContext(ctx, protocol.MigrateBackfillProject)
+		if err != nil {
+			t.Fatalf("first backfill: %v", err)
+		}
+		_, err = db.ExecContext(ctx, protocol.MigrateBackfillProject)
+		if err != nil {
+			t.Fatalf("second backfill (idempotency): %v", err)
+		}
+
+		var project string
+		err = db.QueryRowContext(ctx, `SELECT project FROM memories`).Scan(&project)
+		if err != nil {
+			t.Fatalf("query after double backfill: %v", err)
+		}
+		if project != "oro" {
+			t.Errorf("expected project='oro' after idempotent backfill, got %q", project)
+		}
+	})
+}
