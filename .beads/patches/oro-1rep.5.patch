+// MigrateProjectColumn adds the project column to existing memories tables.
+// Uses a try/ignore pattern since SQLite doesn't support IF NOT EXISTS for ALTER TABLE.
+const MigrateProjectColumn = `
+ALTER TABLE memories ADD COLUMN project TEXT NOT NULL DEFAULT '';
+`
+
+// MigrateBackfillProject sets project='oro' on all existing rows that have an
+// empty project. Safe to run multiple times (idempotent UPDATE).
+const MigrateBackfillProject = `
+UPDATE memories SET project = 'oro' WHERE project = '';
+`
