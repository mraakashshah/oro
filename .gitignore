.env

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.worktrees/

# OS
.DS_Store
Thumbs.db

# Reference repos (cloned locally, not tracked)
docs/alternative-architecture-analysis/reference/

# Node.js
node_modules/

# Build artifacts
/oro
/oro-search-hook
coverage.out
report.json
state.db
__pycache__/
.cache/
.gocache/
.tmp/
.tmp-test/
.claude/hooks/oro-search-hook
cmd/oro/_assets/

# Runtime artifacts (not tracked — vary per machine/session)
.claude/scheduled_tasks.lock
.claude/worktrees/
/.oro-quality-gate.lock*
/.oro-quality-gate.queue/
/.qg-local/
/.qg-cache/
# Go/lint caches created by quality-gate runs and ad-hoc worker invocations.
# These are regenerable build artifacts, but an UNIGNORED one makes
# `git status --porcelain` non-empty, which the dispatcher reads as
# unpreserved work and quarantines as stale_active_assignment — that froze
# the factory on 2026-07-28. Patterns are unanchored and cover the per-bead
# suffixed forms (e.g. .gocache-oro-3zk9) seen in worker worktrees.
.gocache*/
.golangci-cache*/
.golangci-lint-cache/
.task-gocache/
.qg-go-cache/
.qg-lint-cache/
.qg-golangci-cache/
# Undotted forms nested under .oro/ — leading-dot patterns above miss these.
.oro/gocache/
.oro/golangci-cache/
**/dispatcher.exit.log
.gstack/
pkg/dispatcher/workers/
/.oro/context_pct
/.oro/review-pattern-candidates.md
/.oro/review-pattern-candidates.promoted.md
/.oro/state.sqlite

# Local config
.claude/settings.local.json
.perles/
uv.lock
docs/handoffs/
archive/yap/reference/
*.db
/.oro/context_summary.txt
/.oro/handoff_done
